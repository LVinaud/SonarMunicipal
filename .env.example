QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=projetos-de-lei
# Busca exata (padrão). Use false para o índice aproximado HNSW.
QDRANT_EXACT_SEARCH=true

# Modelo de embeddings da consulta (ONNX, roda localmente). Deve ser o mesmo da indexação.
EMBEDDING_MODEL_ID=Xenova/multilingual-e5-base
# Pasta de cache do modelo (opcional; padrão: dentro de node_modules)
EMBEDDING_CACHE_DIR=

POLICY_EXPLORER_CACHE_TTL_SECONDS=0
POLICY_EXPLORER_CACHE_MAX_ITEMS=100

NEXT_PUBLIC_SITE_URL=http://localhost:3000
